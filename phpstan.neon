includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - Modules/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Test modul ikut tidak dianalisis, sama seperti tests/ sebelumnya.
    excludePaths:
        - Modules/*/Tests/*

    level: 7
